<?xml version="1.0" encoding="utf-8"?>
<!--
  AI Content Shield. Least privilege:
  - packageNames limits events to the supported apps (SupportedApps.kt; a
    test keeps both lists equal). The service narrows it further at runtime
    to the apps the user left on, and switches content events off while
    the shield or protection is off.
  - canRetrieveWindowContent is needed to read visible text in those apps.
    Password fields are never read; the only editable field read is the
    app's focused search box (for search protection). Text is classified
    in memory and discarded.
  - canPerformGestures: to skip blocked content (one swipe to the next
    reel/item) and Back when the user asks. Blocked content is covered by
    SafeGuard's own accessibility overlay (its message only); the user is
    never sent out of the app. No accessibility screenshots (images come
    only from MediaProjection, with Android's consent dialog).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="300"
    android:packageNames="com.android.chrome,com.facebook.katana,com.facebook.lite,com.google.android.youtube,com.instagram.android,com.reddit.frontpage,com.ss.android.ugc.trill,com.zhiliaoapp.musically,org.mozilla.firefox"
    android:description="@string/content_shield_description"
    android:summary="@string/content_shield_summary" />
