<?xml version="1.0" encoding="utf-8"?>
<!--
  PIN hashes are encrypted with a device-bound Keystore key; restoring them on
  another device would produce unreadable data. Exclude everything from cloud
  backup and device-to-device transfer (Android 12+).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
